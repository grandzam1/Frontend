# Neon Postgres connection string (server only — never expose to the browser)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Admin unlock PIN for /api/sites mutations
ADMIN_PIN=1234

# PostHog (browser — use the project token that starts with phc_)
VITE_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com

# PostHog (server/CLI only — never prefix these with VITE_)
# POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxx
# POSTHOG_PROJECT_ID=12345
# POSTHOG_PROJECT_SECRET=phs_xxxxxxxx
