{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/sites.ts": {
      "maxDuration": 30,
      "includeFiles": "api/lib/**"
    },
    "api/can-embed.ts": {
      "maxDuration": 30,
      "includeFiles": "api/lib/**"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
